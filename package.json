{
    "name": "build-conditions-workspace",
    "private": true,
    "license": "MIT",
    "scripts": {
        "build": "pnpm -r run build",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "storybook": "pnpm --filter @memebattle/build-conditions run storybook",
        "typecheck": "tsc -b",
        "unit": "NODE_OPTIONS=--experimental-vm-modules jest",
        "unit:swc-plugin": "pnpm --filter @memebattle/build-conditions-swc run test"
    },
    "devDependencies": {
        "@swc/core": "1.16.20",
        "@swc/jest": "0.2.39",
        "@types/jest": "30.0.0",
        "@types/node": "24.19.2",
        "jest": "30.5.2",
        "oxfmt": "0.75.0",
        "typescript": "6.0.3"
    },
    "packageManager": "pnpm@12.16.1"
}
