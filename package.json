{
    "name": "@memebattle/build-conditions",
    "version": "0.2.0",
    "description": "Build-time code splitting by arbitrary conditions: runtime helpers plus an SWC plugin that inlines branches and removes dead code",
    "license": "MIT",
    "author": "Artem Zverev <themezv@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/Themezv/build-conditions.git"
    },
    "packageManager": "pnpm@12.16.1",
    "files": [
        "src",
        "dist",
        "!src/**/*.test.*",
        "!src/**/*.story.*",
        "!src/testGroups.d.ts"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "sideEffects": false,
    "exports": {
        ".": "./src/index.ts",
        "./testing": "./src/testing.ts",
        "./storybook-addon": "./src/addon/index.ts",
        "./swc-plugin": "./dist/swc_plugin_build_conditions.wasm",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "run-s 'build:*'",
        "build:cleanup": "rm -rf dist && mkdir dist",
        "build:swc-plugin": "cd ./swc-plugin && cargo build --locked --target wasm32-wasip1 --release && cp ./target/wasm32-wasip1/release/swc_plugin_build_conditions.wasm ../dist/swc_plugin_build_conditions.wasm",
        "prepack": "test -f dist/swc_plugin_build_conditions.wasm || { echo 'dist/ is missing: run pnpm run build first' >&2; exit 1; }",
        "prettier": "prettier --write '**/*.{js,jsx,ts,tsx,css,json,yaml,yml}'",
        "storybook": "storybook dev -p 9010 -c ./.config/storybook",
        "storybook:build": "storybook build -c ./.config/storybook --quiet",
        "typecheck": "tsc -b",
        "unit": "jest",
        "unit:swc-plugin": "cd ./swc-plugin && cargo test"
    },
    "devDependencies": {
        "@rsbuild/core": "2.2.14",
        "@storybook/react": "10.6.5",
        "@swc/core": "1.16.20",
        "@swc/jest": "0.2.39",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@types/jest": "30.0.0",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "jest": "30.5.2",
        "jest-environment-jsdom": "30.5.2",
        "npm-run-all2": "9.0.4",
        "prettier": "3.9.10",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "storybook": "10.6.5",
        "storybook-react-rsbuild": "3.6.1",
        "typescript": "6.0.3"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    }
}
